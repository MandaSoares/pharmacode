{
  "expo": {
    "name": "PharmaCode",
    "slug": "pharmacode",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#4164E0"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "O app precisa da camera para escanear o codigo de barras do remedio."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4164E0"
      },
      "permissions": ["CAMERA"]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "O app precisa da camera para escanear o codigo de barras do remedio."
        }
      ]
    ]
  }
}
