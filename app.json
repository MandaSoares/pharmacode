{
  "expo": {
    "name": "PharmaCode",
    "slug": "pharmacode",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "O app precisa da camera para escanear o codigo de barras do remedio."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4164E0"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "O app precisa da camera para escanear o codigo de barras do remedio.",
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4164E0"
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "983d4a77-9c9b-4bec-85bd-82f02b294f60"
      }
    },
    "owner": "upxs-team",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/983d4a77-9c9b-4bec-85bd-82f02b294f60"
    }
  }
}
