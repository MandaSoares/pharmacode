# Copie este arquivo para .env e preencha com o endereco da API no Tailscale.
# O celular precisa estar conectado ao Tailscale (app Tailscale instalado e ligado).
# Exemplo: EXPO_PUBLIC_API_URL=http://100.101.102.103:8080
# Sem esta linha, o app usa os dados de exemplo de src/data/medicamentos.js.
EXPO_PUBLIC_API_URL=
